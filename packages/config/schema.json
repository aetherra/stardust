        "secret": {
          "default": "`sigmasigmaonthewall`",
          "description": "The JWT secret used to sign tokens.",
          "type": "string"
        },
        "turnstile": {
          "$ref": "#/definitions/TurnstileConfig",
          "description": "Cloudflare turnstile configuration. Leave `undefined` to disable turnstile."
        }
      },
      "type": "object"
    },
    "Config": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "$ref": "#/definitions/AuthConfig"
        },
        "databaseUrl": {
          "description": "The URL of the database to connect to.",
          "type": "string"
        },
        "metadataUrl": {
          "description": "The public URL of your Stardust instance. Use this if you want to display site metadata.",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/definitions/NodeConfig"
          },
          "type": "array"
        },
        "port": {
          "default": 3000,
          "description": "Port to run stardust on",
          "type": "number"
        },
        "session": {
          "$ref": "#/definitions/SessionConfig"
        }
      },
      "required": [
        "databaseUrl",
        "nodes",
        "auth"
      ],
      "type": "object"
    },
    "NodeConfig": {
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "default": "0.0.0.0",
          "description": "Hostname of the stardust node",
          "type": "string"
        },
        "id": {
          "description": "ID of the node. Make it a unique string that helps identify it. This MUST be under 16 characters or issues can happen.",
          "type": "string"
        },
        "port": {
          "default": 4000,
          "description": "Port stardustd is running on.",
          "type": "number"
        },
        "proto": {
          "default": "http",
          "description": "Protocol to use for the node",
          "type": "string"
        },
        "token": {
          "description": "Authentication token for the node.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "proto",
        "token"
      ],
      "type": "object"
    },
    "SessionConfig": {
      "additionalProperties": false,
      "properties": {
        "dnsServers": {
          "default": "system default",
          "description": "Dns servers for the container to use",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "keepaliveDuration": {
          "default": 1440,
          "description": "The amount of time to keep an inactive session alive for, in minutes.",
          "type": "number"
        },
        "usageLimits": {
          "additionalProperties": false,
          "description": "Session per user usage limit configuration",
          "properties": {
            "instance": {
              "type": "number"
            },
            "user": {
              "type": "number"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "TurnstileConfig": {
      "additionalProperties": false,
      "properties": {
        "secret": {
          "description": "The Turnstile secret key, used by the backend",
          "type": "string"
        },
        "siteKey": {
          "description": "The Turnstile site key, used by the frontend",
          "type": "string"
        }
      },
      "required": [
        "secret",
        "siteKey"
      ],
      "type": "object"
    }
