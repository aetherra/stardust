{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "stardustd"],
			"env": ["CONFIG"]
		},
		"//#check": {},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["CONFIG"]
		},
		"config-schema": {
			"cache": false
		}
	}
}
