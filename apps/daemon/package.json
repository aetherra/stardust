{
  "name": "daemon",
  "type": "module",
  "version": "1.0.3",
  "scripts": {
    "start": "./stardustd",
    "build:debug": "bun build src/server.ts --compile --sourcemap --outfile stardustd",
    "build": "bun build src/server.ts --compile --minify --outfile stardustd",
    "dev": "bun run --watch src/server.ts",
    "check-types": "tsc --noEmit",
    "config-schema": "ts-json-schema-generator --tsconfig ./tsconfig.json --path ./src/lib/config/types.d.ts --type Config > ./schema.json"
  },
  "imports": {
    "~/*": "./src/*"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "ajv": "^8.20.0",
    "dockerode": "^4.0.12",
    "elysia": "latest",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@stardust/theme": "workspace:*",
    "@stardust/tsconfig": "workspace:*",
    "@types/dockerode": "^3.3.47",
    "@types/js-yaml": "^4.0.9",
    "bun-types": "latest",
    "ts-json-schema-generator": "^2.9.0"
  },
  "module": "src/index.ts"
}
